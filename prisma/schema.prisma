generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// --- TABEL AUTENTIKASI --- //
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Akan menyimpan password yang sudah di-hash (misal pakai bcrypt)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- TABEL ENTITAS UTAMA --- //
model Student {
  id           String   @id @default(cuid())
  nis          String   @unique
  name         String
  class        String
  qrCodeHash   String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  visits       Visit[]
  loans        Loan[]
}

model Book {
  id            String   @id @default(cuid())
  isbn          String   @unique
  title         String
  author        String
  publisher     String?
  publishYear   Int?
  category      String?
  coverUrl      String?
  stock         Int      @default(1)
  stockTotal    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loans         Loan[]
}

// --- TABEL TRANSAKSI --- //
model Visit {
  id           String    @id @default(cuid())
  studentId    String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  
  student      Student   @relation(fields: [studentId], references: [id])
  feedback     Feedback?
}

model Loan {
  id           String    @id @default(cuid())
  studentId    String
  bookId       String
  borrowedAt   DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  isOverdue    Boolean   @default(false)
  notes        String?

  student      Student   @relation(fields: [studentId], references: [id])
  book         Book      @relation(fields: [bookId], references: [id])
}

// --- TABEL PENGATURAN SISTEM --- //
model SystemSettings {
  id              String   @id @default("default") // Kita set id selalu "default" karena cuma butuh 1 baris
  
  // Profil
  namaSekolah     String   @default("SMP Negeri 1 Banjar")
  alamat          String   @default("Jl. Pendidikan No. 1, Banjar, Buleleng, Bali")
  kepalaSekolah   String   @default("Drs. I Wayan Contoh, M.Pd.")
  nipKepala       String   @default("19700101 199512 1 001")
  pustakawan      String   @default("Luh Putu Perpustakaan, S.I.P.")
  nipPustakawan   String   @default("19850505 201001 2 002")
  
  // Aturan
  maxPinjamHari   Int      @default(7)
  maxBukuSiswa    Int      @default(3)
  dendaPerHari    Int      @default(1000)

  updatedAt       DateTime @updatedAt
}

// --- TABEL FEEDBACK --- //
model Feedback {
  id        String   @id @default(cuid())
  visitId   String   @unique
  rating    Int      // 1 = buruk, 2 = biasa, 3 = bagus, 4 = luar biasa
  comment   String?  // <--- TAMBAHKAN BARIS INI
  createdAt DateTime @default(now())

  visit     Visit    @relation(fields: [visitId], references: [id])
  options   FeedbackOnOption[]
}

model FeedbackOption {
  id    String @id @default(cuid())
  label String 
  type  FeedbackType 

  feedbacks FeedbackOnOption[]
}

model FeedbackOnOption {
  feedbackId       String
  feedbackOptionId String
  
  feedback         Feedback       @relation(fields: [feedbackId], references: [id])
  option           FeedbackOption @relation(fields: [feedbackOptionId], references: [id])

  @@id([feedbackId, feedbackOptionId])
}

enum FeedbackType {
  POSITIVE
  NEGATIVE
}